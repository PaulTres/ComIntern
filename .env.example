# ComIntern settings. Copy to .env (cp .env.example .env) and adjust; .env is never committed.
# Nested groups use "__": DATABASE__URL is Settings.database.url (src/comintern/configuration/config.py).
# These values are for running the API on your machine; docker-compose.yml overrides the
# host names for the containers (db, qdrant, host.docker.internal).
# Everything is local and free: PostgreSQL and Qdrant in Docker, FastEmbed in the API, Ollama on your machine.

# PostgreSQL (dev/docker-compose.yml publishes it on localhost:5432)
DATABASE__URL=postgresql+asyncpg://comintern:comintern@localhost:5432/comintern
DATABASE__USER=comintern
DATABASE__PASSWORD=comintern
DATABASE__NAME=comintern
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10

# API
LOGGING__LEVEL=INFO
RUN__HOST=127.0.0.1
RUN__PORT=8000
CORS__ORIGINS=["http://localhost:3000"]

# Access tokens: at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT__SECRET_KEY=change-me-to-a-long-random-string-of-48-characters
JWT__ALGORITHM=HS256
JWT__EXPIRE_MINUTES=1440

# Evidence uploads and official regulation texts (one subfolder per regulation code, e.g. regulation_texts/EU_GDPR/)
DOCUMENTS__UPLOAD_DIRECTORY=data/uploads
DOCUMENTS__REGULATION_TEXTS_DIRECTORY=regulation_texts
DOCUMENTS__MAX_FILE_SIZE_BYTES=26214400

# How texts are cut into passages before embedding
CHUNKING__CHUNK_SIZE=1200
CHUNKING__CHUNK_OVERLAP=150

# Qdrant (dev/docker-compose.yml publishes it on localhost:6333 and creates the collection)
VECTOR_STORE__PROVIDER=qdrant
VECTOR_STORE__URL=http://localhost:6333
VECTOR_STORE__COLLECTION_NAME=comintern
VECTOR_STORE__TIMEOUT_SECONDS=30

# Embeddings: FastEmbed runs on the CPU inside the API. The model must cover EN, DE and RO;
# SIZE must match the model (768 for this one) and the Qdrant collection.
EMBEDDINGS__PROVIDER=fastembed
EMBEDDINGS__MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDINGS__SIZE=768
EMBEDDINGS__BATCH_SIZE=32
EMBEDDINGS__CACHE_DIRECTORY=.cache/fastembed

# Chat model: Ollama on your machine (ollama serve; ollama pull gemma4:12b).
# The model must support tool calling. On a laptop with less than 16 GB RAM use llama3.2:3b.
LLM__PROVIDER=ollama
LLM__MODEL_NAME=gemma4:12b
LLM__BASE_URL=http://localhost:11434
LLM__TEMPERATURE=0.2
LLM__MAX_TOKENS=1024
LLM__TIMEOUT_SECONDS=180
# true lets a thinking model (gemma4) think first: better on hard questions, about 10x slower on a laptop
LLM__REASONING=false

# Agents
ORCHESTRATOR_AGENT__MAX_RECURSION_LIMIT=8
KNOWLEDGE_AGENT__MAX_RECURSION_LIMIT=12
KNOWLEDGE_AGENT__TOP_K=6
KNOWLEDGE_AGENT__SIMILARITY_SCORE=0.3
KNOWLEDGE_AGENT__HISTORY_TURNS=3
KNOWLEDGE_AGENT__CHUNK_PREVIEW_LENGTH=400
REGULATION_AGENT__TOP_K=4
REGULATION_AGENT__SIMILARITY_SCORE=0.3
REGULATION_AGENT__HISTORY_TURNS=3
